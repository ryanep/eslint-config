{
  "name": "@ryanep/eslint-config",
  "version": "0.0.0-development",
  "description": "A personal ESLint config",
  "keywords": [
    "eslint-config"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ryanep/eslint-config"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    }
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib",
    "readme.md"
  ],
  "scripts": {
    "build": "tsup --format esm,cjs --clean --dts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "precommit": "lint-staged",
    "prepare": "husky",
    "release": "semantic-release",
    "scan": "tsx ./scripts/scan",
    "typecheck": "tsc --noEmit"
  },
  "overrides": {
    "eslint": "$eslint"
  },
  "dependencies": {
    "@eslint/compat": "^2.1.0",
    "@graphql-eslint/eslint-plugin": "^4.4.0",
    "@next/eslint-plugin-next": "^16.2.7",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-jsdoc": "^63.0.2",
    "eslint-plugin-jsonc": "^3.2.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.0",
    "eslint-plugin-regexp": "^3.1.0",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^65.0.1",
    "eslint-plugin-yml": "^3.4.0",
    "globals": "^17.6.0",
    "jsonc-eslint-parser": "^3.1.0",
    "yaml-eslint-parser": "^2.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@ryanep/prettier-config": "^1.3.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/eslint": "^9.6.1",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/eslint-plugin-tailwindcss": "^3.17.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.1",
    "eslint": "^10.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "semantic-release": "^25.0.3",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
